{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color":{
      "1": "blue"
    },
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
      "separator": " ",
      "constants": [
          "──────────────────────────────"
      ]
  },
  "modules": [
    "title",
    "break",
    {
      "type":"os",
      "key": ""
    },
    {
      "type":"host",
      "key": ""
    },
    {
      "type":"kernel",
      "key": "󰌽"
    },
    {
      "type":"packages",
      "key": "󰏖"
    },
    {
      "type":"de",
      "key": ""
    },
    {
      "type":"wmtheme",
      "key": ""
    },
    {
      "type":"uptime",
      "key": "󰔚"
    },
    "break",
    "colors"
  ]
}
